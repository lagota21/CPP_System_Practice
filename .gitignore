# =========================
# Visual Studio / C++ Ignore
# =========================

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual C++ cache files
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb

# Compiled object files
*.obj
*.o
*.lo
*.slo
*.pch
*.pdb
*.ilk
*.rsp
*.sbr

# Compiled binaries
*.exe
*.dll
*.lib
*.so
*.app
*.out

# Other auto-generated Visual Studio files
*.idb
*.ipdb
*.pgc
*.pgd
*.iobj
*.tmp
*.tmp_proj
*.log

# CMake cache and build files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
_deps/

# MacOS / Windows metadata
.DS_Store
Thumbs.db

# =========================
# Optional: temp / backup files
# =========================
*~
~$*
*.bak
*.old
*.orig

